{
  "name": "the-internal-network-server",
  "version": "1.0.0",
  "description": "Real-time internal messaging platform - Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:all": "tsc && npm install --prefix ../frontend && npm run build --prefix ../frontend",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/selfCheck.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
